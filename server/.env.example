# ---------- Core ----------
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173

# ---------- Google Sign-In ----------
# Create an OAuth 2.0 Web client in Google Cloud Console and add your deployed frontend origin.
GOOGLE_CLIENT_ID=
# Comma-separated Google emails that become admins on sign-in
ADMIN_EMAILS=you@example.com
# Development only: enables POST /auth/dev-login. Must remain false in production.
DEV_AUTH=true

# ---------- Payments ----------
# Set DEMO_MODE=true in Vercel for a demo deployment. Simulated payments only; never real transactions.
# When DEMO_MODE=false in production, valid Razorpay keys and webhook secret are required.
DEMO_MODE=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SLOT_HOLD_MINUTES=10
REFUND_CUTOFF_HOURS=2

# ---------- Video (Jitsi) ----------
JITSI_DOMAIN=meet.jit.si

# ---------- Branding ----------
CLINIC_NAME=Tulasi Healthcare
CLINIC_ADDRESS=Bengaluru, Karnataka, India
