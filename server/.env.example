# ---------- Core ----------
NODE_ENV=development
PORT=5000
MONGODB_URI=MONGODB_URI="mongodb+srv://kulkarni219_db_user:_iiTM@dP@@Y5Hs6@cluster0.pyj6xty.mongodb.net/tulasi_healthconnect?appName=Cluster0"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173

# ---------- Google Sign-In ----------
# Create an OAuth 2.0 Web client at https://console.cloud.google.com/apis/credentials
# Add http://localhost:5173 (and your Vercel URL) under "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=
# Comma-separated Google emails that become admins on sign-in
ADMIN_EMAILS=you@example.com
# Development only: enables POST /auth/dev-login so you can test without Google. Ignored/forbidden in production.
DEV_AUTH=true

# ---------- Razorpay (test mode) ----------
# Leave keys empty in development to use MOCK payments. Use rzp_test_* keys for real test-mode checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SLOT_HOLD_MINUTES=10
REFUND_CUTOFF_HOURS=2

# ---------- Video (Jitsi) ----------
# Public meet.jit.si works with no key. Point to your own Jitsi server for production-grade privacy.
JITSI_DOMAIN=meet.jit.si

# ---------- Branding (printed on prescriptions) ----------
CLINIC_NAME=Tulasi Healthcare
CLINIC_ADDRESS=Bengaluru, Karnataka, India
